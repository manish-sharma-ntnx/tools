# MSP Pipeline Dashboard configuration.
# Sourced by systemd as an EnvironmentFile. KEY=VALUE only — no quotes needed
# unless the value has spaces. Restart after edits:
#   sudo systemctl restart msp-pipeline-dashboard

# =============================================================================
# HTTP server
# =============================================================================
# Port the dashboard listens on (open this in the firewall if reaching remotely).
PORT=4317
# Bind address. 0.0.0.0 = reachable from other machines; 127.0.0.1 = this host only.
HOST=0.0.0.0
# Public URL used as the "Open dashboard" link in Slack. Set this to the FQDN
# or IP people actually type in a browser. If unset, it is derived from HOST+PORT.
#DASHBOARD_URL=http://<this-host-fqdn-or-ip>:4317

# =============================================================================
# Jenkins polling
# =============================================================================
# How often to refresh pipeline status, in milliseconds (180000 = 3 minutes).
POLL_INTERVAL_MS=180000
# Per-request HTTP timeout (ms) and how many Jenkins jobs to fetch in parallel.
HTTP_TIMEOUT_MS=20000
FETCH_CONCURRENCY=8

# =============================================================================
# Slack — master switch and transport
# =============================================================================
# true  = post to the channel below (needs a bot token or webhook)
# false = pause EVERY Slack post; dashboard keeps polling; tokens stay in place
SLACK_ENABLED=true
#
# Channel for 10-fail alerts, patch-threshold alerts, and the scheduled digest
# (unless MASTER_DIGEST_CHANNEL is set). /api/digest/test uses this channel too.
SLACK_CHANNEL=#test-msp
# Group mention added to digest / alert footers (e.g. @msp-help).
SLACK_MENTION=@msp-help
# Re-alert suppression per pipeline, in milliseconds (21600000 = 6 hours).
SLACK_COOLDOWN_MS=21600000
#
# Provide ONE transport. If none is set, events are logged only (never posted).
# Bot token (xoxb-...) — required for the scheduled digest. Slack app needs
# chat:write; /invite the bot into SLACK_CHANNEL (or add chat:write.public).
#SLACK_BOT_TOKEN=xoxb-...
# Incoming webhook — 10-fail / patch alerts only (cannot post the digest).
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# App-level token (xapp-...) cannot post. Unused for outbound messages.
#SLACK_APP_TOKEN=xapp-...
# Legacy alias if SLACK_BOT_TOKEN is unset.
#SLACK_ALERT_BOT_TOKEN=xoxb-...

# =============================================================================
# Failure thresholds
# =============================================================================
# Master digest: consecutive failed builds that make a MASTER lane report-worthy
# (msp-master Precommit / Local LCC / GLCC / ValPromote LKG + master Smoke / LKG).
MASTER_FAIL_THRESHOLD=5
# Patch-release (non-master) lanes, e.g. ganges-7.7 LKG / 7.6.1 Precommit.
# Per-poll Slack alert when consecutiveFailures reaches this (same 6h cooldown).
# The Slack text reports the observed streak, not this threshold number.
# Master lanes are excluded so they are not double-pinged with the digest.
PATCH_FAIL_THRESHOLD=3
# Static Devtest (msp-controller-precommit). Same per-poll Slack path as patch
# lanes, but a separate threshold so Devtest can be tuned independently.
DEVTEST_FAIL_THRESHOLD=3

# =============================================================================
# Success digest (optional — OFF by default)
# =============================================================================
# When true, the same daily schedule also posts master lanes that have
# succeeded >= SUCCESS_THRESHOLD consecutive completed builds.
# Leave false until you want green status posts in the channel.
SUCCESS_DIGEST_ENABLED=false
# Consecutive successful builds that make a master lane report-worthy.
SUCCESS_THRESHOLD=5

# =============================================================================
# Scheduled digest — when it fires
# =============================================================================
# MASTER_DIGEST_TIMES is 24-hour clock time only. Examples:
#   09:00        → 9:00 in the morning
#   21:00        → 9:00 in the evening
#   09:00,21:00  → both (two posts per timezone per day)
MASTER_DIGEST_TIMES=09:00
#
# Timezones that receive those clock times. Use short names or IANA zones:
#   IST  = India Standard Time          (Asia/Kolkata)
#   PST  = US Pacific (DST-aware)       (America/Los_Angeles)
# So TIMES=09:00 and TZ=IST,PST means 09:00 IST and 09:00 US-Pacific every day.
MASTER_DIGEST_TZ=IST,PST
#
# Toggle the failure digest only. Success digest uses SUCCESS_DIGEST_ENABLED.
MASTER_DIGEST_ENABLED=true
# Override the digest channel (defaults to SLACK_CHANNEL).
#MASTER_DIGEST_CHANNEL=#test-msp
