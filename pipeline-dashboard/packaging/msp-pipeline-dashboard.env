# MSP Pipeline Dashboard configuration.
# This file is sourced by systemd as an EnvironmentFile. Lines are KEY=VALUE.
# Restart the service after editing:  sudo systemctl restart msp-pipeline-dashboard

# --- HTTP server ---
# Port to listen on.
PORT=4317
# Bind address. 0.0.0.0 = reachable from other machines; 127.0.0.1 = localhost only.
HOST=0.0.0.0

# --- Polling ---
# How often to poll Jenkins controllers, in milliseconds (default 3 min).
POLL_INTERVAL_MS=180000
# Per-request HTTP timeout (ms) and controller fan-out concurrency.
HTTP_TIMEOUT_MS=20000
FETCH_CONCURRENCY=8

# --- Slack alerting (optional) ---
# Provide ONE of the transports below to enable live alerts. If neither is set,
# alerts are only logged (never posted).
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
#SLACK_ALERT_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=#test-msp
SLACK_MENTION=@msp-help
# Per-pipeline re-alert suppression window (ms). Default 6h.
SLACK_COOLDOWN_MS=21600000
