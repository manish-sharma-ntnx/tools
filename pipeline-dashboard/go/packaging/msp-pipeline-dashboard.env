# MSP Pipeline Dashboard configuration (Go build).
# This file is sourced by systemd as an EnvironmentFile. Lines are KEY=VALUE.
# Restart the service after editing:  sudo systemctl restart msp-pipeline-dashboard

# --- HTTP server ---
# Port to listen on.
PORT=4317
# Bind address. 0.0.0.0 = reachable from other machines; 127.0.0.1 = localhost only.
HOST=0.0.0.0
# Public URL used for the "Open dashboard" link in Slack messages. Recommended
# behind a proxy/DNS name. If unset, it is derived from this host's name/IP + PORT.
#DASHBOARD_URL=http://<this-host-fqdn-or-ip>:4317

# --- Polling ---
# How often to poll Jenkins controllers, in milliseconds (default 3 min).
POLL_INTERVAL_MS=180000
# Per-request HTTP timeout (ms) and controller fan-out concurrency.
HTTP_TIMEOUT_MS=20000
FETCH_CONCURRENCY=8

# --- Slack alerting (optional) ---
# Master switch for ALL Slack posts (10-fail alerts + daily master digest).
# true  = start posting (needs a token/webhook below)
# false = pause the channel; dashboard keeps polling; tokens stay in place
SLACK_ENABLED=true
#
# Provide ONE transport to enable live posting. If none is set, alerts/digests
# are only logged (never posted).
#
# Bot token (xoxb-...) — used with chat.postMessage. This is what the master
# digest uses. The Slack app needs the `chat:write` scope and the bot must be a
# member of the target channel (or have `chat:write.public`).
#SLACK_BOT_TOKEN=xoxb-...
# App-level token (xapp-...) — ONLY needed later for Socket Mode / inbound
# events. It CANNOT post messages, so it is optional for outbound posting.
#SLACK_APP_TOKEN=xapp-...
# Legacy alias for the bot token (still honored if SLACK_BOT_TOKEN is unset).
#SLACK_ALERT_BOT_TOKEN=xoxb-...
# Incoming-webhook alternative for the per-pipeline failure alert.
#SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_CHANNEL=#test-msp
SLACK_MENTION=@msp-help
# Per-pipeline re-alert suppression window (ms). Default 6h.
SLACK_COOLDOWN_MS=21600000

# --- Master pipeline digest (scheduled Slack post) ---
# Posts the MASTER pipelines (msp-master group: Precommit + Local LCC + GLCC,
# plus standalone LKG) that have failed >= threshold consecutive builds, at
# fixed local times each day. Needs SLACK_BOT_TOKEN above.
MASTER_DIGEST_ENABLED=true
# Consecutive-failure count that makes a master pipeline report-worthy.
MASTER_FAIL_THRESHOLD=5
# Channel for the digest (defaults to SLACK_CHANNEL if unset).
#MASTER_DIGEST_CHANNEL=#test-msp
# Daily send times as "HH:MM TZ" (IANA zones), comma-separated. DST-aware.
# Default = 9am India time and 9am US-Pacific time.
MASTER_DIGEST_TIMES=09:00 Asia/Kolkata,09:00 America/Los_Angeles
